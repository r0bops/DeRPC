{
  "name": "@derpc/wrapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "setup": "node src/setup.ts",
    "check": "node src/check.ts",
    "release:package": "node scripts/package-release.mjs",
