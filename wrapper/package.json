    "test:container": "node test/paid-container.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "puppeteer-core": "25.5.0"
  },
  "dependencies": {
    "@derpc/payments": "workspace:*",
    "viem": "2.57.8"
  }
}
