# Use the operator identity you control; this file does not register an ENS name.
DERPC_ENS_NAME=operator.derpc.eth
# Public address only, never a private key. Replace this placeholder before starting.
DERPC_SIGNER=YOUR_PUBLIC_SIGNER_ADDRESS
DERPC_ENDPOINT_ID=node-a
DERPC_EXECUTION_URL=http://127.0.0.1:8545
DERPC_BEACON_URL=http://127.0.0.1:5052
# Set true only when intentionally forwarding public services instead of your own node.
DERPC_DEMO_PROXY=false
