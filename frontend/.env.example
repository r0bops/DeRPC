# Copy to frontend/.env.local (gitignored) and fill in.

# Comma-separated tor-js gateway KPS addresses ("ip:port:certhash"), as printed by
# `tor-js-gateway` at startup. Leave empty to use the tor-js demo gateway.
# Read by `pnpm dev` and `build:local` only. Release builds ignore this file: they take
# VITE_TOR_GATEWAYS from the shell, require a public gateway and refuse private addresses.
VITE_TOR_GATEWAYS=
